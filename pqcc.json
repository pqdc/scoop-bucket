{
    "version": "0.5.2",
    "description": "The pqdx governance dashboard. Load your {project}.state.yaml and navigate it.",
    "homepage": "https://piqued.cc",
    "license": {
        "identifier": "Freeware",
        "url": "https://piqued.cc/license"
    },
    "notes": [
        "pqcc runs on Node.js. Any supported Node.js LTS on PATH works (nodejs.org installer, nvm, volta, fnm, or 'scoop install nodejs-lts').",
        "Run 'pqcc' to start the dashboard at http://localhost:5678 (set PORT to use another port)."
    ],
    "suggest": {
        "Node.js": [
            "nodejs-lts",
            "nodejs",
            "nvm",
            "nvs"
        ]
    },
    "url": "https://registry.npmjs.org/pqcc/-/pqcc-0.5.2.tgz",
    "hash": "5f6b4213b9c1a81c470a5bb3b4c776eb33b671b952cda3a19e0bea756a60c273",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\pqcc.cmd\" -Encoding Ascii -Value @(",
        "    '@ECHO off',",
        "    'GOTO start',",
        "    ':find_dp0',",
        "    'SET dp0=%~dp0',",
        "    'EXIT /b',",
        "    ':start',",
        "    'SETLOCAL',",
        "    'CALL :find_dp0',",
        "    'SET \"_prog=node\"',",
        "    'SET PATHEXT=%PATHEXT:;.JS;=;%',",
        "    'endLocal & goto #_undefined_# 2>NUL || title %COMSPEC% & \"%_prog%\"  \"%dp0%\\cli\\index.mjs\" %*'",
        ")"
    ],
    "bin": "pqcc.cmd",
    "checkver": {
        "url": "https://registry.npmjs.org/pqcc/latest",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/pqcc/-/pqcc-$version.tgz",
        "hash": {
            "url": "https://registry.npmjs.org/pqcc/$version",
            "regex": "\"integrity\"\\s*:\\s*\"sha512-([A-Za-z0-9+/]{86}==)\""
        }
    }
}
